# Atlas connection string. Include the database name, and use the same one as the server.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/social_events
# A long random string, for example from: openssl rand -base64 32
BETTER_AUTH_SECRET=
# This site's own URL with no trailing slash. It must match CLIENT_URL on the server.
BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console. Add BETTER_AUTH_URL/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Express API URL with no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000
